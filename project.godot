; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SpeedBlitz"
config/description="A SUPER fast-paced roguelike."
run/main_scene="uid://c6fa0tmmqarb"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://dp0xvxmfsotk7"
config/icon="uid://dnhmhmmrdmlv4"
config/windows_native_icon="res://sprites/Icons/SPEEDBLITZ.ico"
boot_splash/minimum_display_time=1500

[audio]

buses/default_bus_layout="uid://dhso2e4jrx644"
general/default_playback_type.web=0
driver/output_latency=100
driver/output_latency.web=100
buses/channel_disable_threshold_db=-40.0

[autoload]

Main="*res://scripts/regular/internal scripts/main.gd"
InputSnapshot="*res://scripts/regular/internal scripts/inputsnapshot.gd"
WebglInitializer="*res://scripts/regular/internal scripts/webgl_initializer.gd"
Firstrun="*res://scripts/regular/internal scripts/firstrun.gd"
SceneManager="*res://scenes/utility scenes/scene_manager.tscn"
OptionsFetch="*res://scripts/regular/internal scripts/options_fetch.gd"
Screen="*uid://67ahy544jxgr"
LevelSave="*uid://6s3sftgltup"
ControllerMouse="*uid://ddx81i3ywyyui"

[debug]

settings/crash_handler/message="lmao hi"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/frame_pacing/android/swappy_mode=0
window/stretch/mode="canvas_items"
window/handheld/orientation=4
mouse_cursor/custom_image="uid://d0m1ffn0i6vt8"
window/icon="uid://dbr5h6pnxbbca"

[editor]

movie_writer/fps=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gdfxr/plugin.cfg", "res://addons/screen_print/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

